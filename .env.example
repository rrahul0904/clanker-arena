APP_ENV=development
PORT=3000
HOST=0.0.0.0
GENERATOR_MODE=mock
JUDGE_MODE=local
STORAGE_MODE=json
AUTH_MODE=demo
DEMO_USER_ID=u_demo
DATA_FILE=.data/state.json
REQUIRE_IDEMPOTENCY_KEY=0
GENERATION_LIMIT_PER_HOUR=30
SUBMISSION_LIMIT_PER_HOUR=60

# Production generation (required when GENERATOR_MODE=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Production sandbox (required when JUDGE_MODE=judge0)
JUDGE0_URL=
JUDGE0_TOKEN=
JUDGE0_LANGUAGE_ID=71
JUDGE0_MEMORY_KB=128000
JUDGE0_MAX_PROCESSES=1
JUDGE0_MAX_FILE_SIZE_KB=64

# Supabase production persistence/auth
# Use modern sb_publishable_* and sb_secret_* keys. Never expose the secret key to browsers.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Unsafe override; leave disabled. Only intended for isolated developer experiments.
ALLOW_UNSAFE_REMOTE_CODE_LOCALLY=0
